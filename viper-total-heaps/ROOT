session TotalViperDeps in TotalViperDeps = ViperCommon +
  sessions
    "HOL-Analysis"
    "HOL-Eisbach"
    Boogie_Lang
  theories
    Dependencies

(* The "global" keywords are for avoiding changing all the imports.
   Imports should be later changed to qualified names. *)

session TotalViperSemantics in Semantics = TotalViperDeps +
  theories
    NestedMaskInst
    NestedMaskProperties
    TotalConsistencyInst
    TotalContext
    TotalExpressions
    TotalExtConsPreservation
    TotalExtConsProps
    TotalExternalConsistency
    TotalFoldUnfold
    TotalFraming
    TotalFramingIndep
    SyntacticMultVarBridge
    TotalInhaleExhale
    TotalIntConsPreservation
    TotalInternalConsistency
    TotalMaskUtil
    TotalResult
    TotalSemantics
    TotalSemanticsHelper
    TotalSemanticsProperties
    TotalSemProperties
    TotalStateInst
    TotalStateProperties
    TotalStateUtil
    TotalUtil
    TotalViperState
    TotalViperUtil

session TotalViperSimulation in Simulation = TotalViperSemantics +
  theories
    BoogieInterface
    BoogieSyntaxBasedProperties
    ExhaleRel
    ExpRel
    ExprWfRel
    InhaleRel
    KnownFolded
    PredicateDefinednessRel
    PredicateRel
    Simulation
    StmtRel
    ViperBoogieAbsValueInst
    ViperBoogieBasicRel
    ViperBoogieEndToEnd
    ViperBoogieFunctionInst
    ViperBoogieRelUtil
    ViperBoogieTranslationInterface

session TotalViper = TotalViperSimulation +
  theories
    CPGHelperML
    ExhaleRelML
    ExpRelML
    ExprWfRelML
    InhaleRelML
    FoldStmtRelKF
    PredicateRelML
    StmtRelML
    TotalViperHelperML
    ViperBoogieEndToEndML
    ViperBoogieHelperML

session TotalViperRefinementDeps in Others = TotalViperSemantics +
  theories
    TraceIndepProperty
