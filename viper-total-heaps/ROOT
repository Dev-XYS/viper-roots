session TotalViperDeps in TotalViperDeps = ViperCommon +
  sessions
    "HOL-Analysis"
    "HOL-Eisbach"
    Boogie_Lang
  theories
    Dependencies

(* The "global" keywords are for avoiding changing all the imports.
   Imports should be later changed to qualified names. *)

session TotalViperSemantics in Semantics = TotalViperDeps +
  theories
    NestedMaskInst (global)
    NestedMaskProperties (global)
    TotalConsistencyInst (global)
    TotalContext (global)
    TotalExpressions (global)
    TotalExtConsPreservation (global)
    TotalExtConsProps (global)
    TotalExternalConsistency (global)
    TotalFoldUnfold (global)
    TotalFraming (global)
    TotalInhaleExhale (global)
    TotalIntConsPreservation (global)
    TotalInternalConsistency (global)
    TotalMaskUtil (global)
    TotalResult (global)
    TotalSemantics (global)
    TotalSemanticsHelper (global)
    TotalSemanticsProperties (global)
    TotalSemProperties (global)
    TotalStateInst (global)
    TotalStateProperties (global)
    TotalStateUtil (global)
    TotalUtil (global)
    TotalViperState (global)
    TotalViperUtil (global)

session TotalViperSimulation in Simulation = TotalViperSemantics +
  theories
    BoogieInterface (global)
    BoogieSyntaxBasedProperties (global)
    ExhaleRel (global)
    ExpRel (global)
    ExprWfRel (global)
    InhaleRel (global)
    KnownFolded (global)
    PredicateRel (global)
